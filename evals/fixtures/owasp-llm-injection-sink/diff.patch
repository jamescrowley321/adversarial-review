+"use strict";
+
+const { exec } = require("child_process");
+const { chat } = require("./llm");
+const { fetchDoc } = require("./retrieval");
+
+// Summarize a retrieved document and run the follow-up shell action it suggests.
+async function summarizeAndAct(docId) {
+  const doc = await fetchDoc(docId);
+  const prompt =
+    "Summarize this document and emit a shell command to file it:\n" + doc.text;
+  const reply = await chat({ model: "gpt-5", input: prompt });
+
+  // reply.command is the shell line the model produced.
+  return new Promise((resolve, reject) => {
+    exec(reply.command, (err, stdout) => {
+      if (err) return reject(err);
+      resolve(stdout);
+    });
+  });
+}
+
+module.exports = { summarizeAndAct };
