+import { db } from "../db/client";
+import { sendDigest } from "../mail/digest";
+
+/** True when `at` falls inside the user's configured quiet hours. */
+export function inQuietHours(at: Date, start: string | null, end: string | null): boolean {
+  if (!start || !end) return false;
+  const minutes = at.getUTCHours() * 60 + at.getUTCMinutes();
+  const [sh, sm] = start.split(":").map(Number);
+  const [eh, em] = end.split(":").map(Number);
+  const from = sh * 60 + sm;
+  const to = eh * 60 + em;
+  // A window that wraps midnight (22:00 -> 07:00) is inside when EITHER side matches.
+  return from <= to ? minutes >= from && minutes < to : minutes >= from || minutes < to;
+}
+
+export async function runDigest(now = new Date()) {
+  const rows = await db.many(
+    `select u.id, u.email, p.quiet_start, p.quiet_end
+       from users u
+       join user_preferences p on p.user_id = u.id
+      where p.digest_enabled = true`,
+  );
+  for (const row of rows) {
+    if (inQuietHours(now, row.quiet_start, row.quiet_end)) continue;
+    await sendDigest(row.email);
+  }
+}
