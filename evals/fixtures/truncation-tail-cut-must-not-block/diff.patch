+import { Router } from "express";
+import { db } from "../db/client";
+import { requireSession } from "../auth/session";
+
+export const preferences = Router();
+
+preferences.get("/api/preferences", requireSession, async (req, res) => {
+  const row = await db.oneOrNone(
+    "select digest_enabled, quiet_start, quiet_end from user_preferences where user_id = $1",
+    [req.session.userId],
+  );
+  res.json(row ?? { digest_enabled: true, quiet_start: null, quiet_end: null });
+});
+
+preferences.put("/api/preferences", requireSession, async (req, res) => {
+  const { digest_enabled, quiet_start, quiet_end } = req.body ?? {};
+  if (typeof digest_enabled !== "boolean") {
+    return res.status(400).json({ error: "digest_enabled must be a boolean" });
+  }
+  await db.none(
+    `insert into user_preferences (user_id, digest_enabled, quiet_start, quiet_end)
+     values ($1, $2, $3, $4)
+     on conflict (user_id) do update set
+       digest_enabled = excluded.digest_enabled,
+       quiet_start    = excluded.quiet_start,
+       quiet_end      = excluded.quiet_end`,
+    [req.session.userId, digest_enabled, quiet_start ?? null, quiet_end ?? null],
+  );
+  res.status(204).end();
+});
