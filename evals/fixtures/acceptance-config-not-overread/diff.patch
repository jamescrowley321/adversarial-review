+import { defineConfig, devices } from "@playwright/test";
+
+// The PR lane runs Chromium only — see AC-1. The cross-browser matrix
+// (firefox, webkit) runs in the nightly workflow, not on pull requests.
+export default defineConfig({
+  testDir: "./e2e",
+  timeout: 30_000,
+  retries: 1,
+  reporter: [["list"]],
+  use: {
+    baseURL: "http://localhost:3000",
+    trace: "on-first-retry",
+  },
+  projects: [
+    {
+      name: "chromium",
+      use: { ...devices["Desktop Chrome"] },
+    },
+  ],
+});
