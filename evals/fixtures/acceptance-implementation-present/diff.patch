+import { useCallback, useState } from "react";
+
+export interface Result {
+  id: string;
+  href: string;
+  label: string;
+}
+
+/**
+ * Keyboard navigation for the search-results dropdown.
+ * ArrowDown/ArrowUp move the highlight (wrapping at both ends),
+ * Enter navigates to the highlighted result, Escape closes and restores focus.
+ */
+export function useResultNavigation(results: Result[], onClose: () => void) {
+  const [index, setIndex] = useState(0);
+
+  const onKeyDown = useCallback(
+    (event: KeyboardEvent) => {
+      if (results.length === 0) return;
+
+      switch (event.key) {
+        case "ArrowDown":
+          event.preventDefault();
+          setIndex((i) => (i + 1) % results.length);
+          return;
+        case "ArrowUp":
+          event.preventDefault();
+          setIndex((i) => (i - 1 + results.length) % results.length);
+          return;
+        case "Enter": {
+          event.preventDefault();
+          const target = results[index];
+          if (target) window.location.assign(target.href);
+          return;
+        }
+        case "Escape":
+          event.preventDefault();
+          onClose();
+          document.getElementById("search-input")?.focus();
+          return;
+        default:
+          return;
+      }
+    },
+    [results, index, onClose],
+  );
+
+  return { index, onKeyDown };
+}
