+import { db } from "../db/client";
+import { search } from "../search/client";
+
+const BATCH = 250;
+
+export async function reindexDocuments(since: Date) {
+  let cursor = since;
+  for (;;) {
+    const rows = await db.many(
+      "select id, tenant_id, title, body, updated_at from documents where updated_at > $1 order by updated_at asc limit $2",
+      [cursor, BATCH],
+    );
+    if (!rows.length) return;
+    await search.bulkIndex(rows.map((r) => ({ id: r.id, tenant: r.tenant_id, title: r.title, body: r.body })));
+    cursor = rows[rows.length - 1].updated_at;
+  }
+}
