+import { useEffect, useState } from "react";
+import { api } from "../api/client";
+
+interface Doc {
+  id: string;
+  title: string;
+  updatedAt: string;
+}
+
+export function DocumentList({ query }: { query: string }) {
+  const [docs, setDocs] = useState<Doc[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    let cancelled = false;
+    setLoading(true);
+    api
+      .get<Doc[]>(`/api/documents?q=${encodeURIComponent(query)}`)
+      .then((rows) => {
+        if (cancelled) return;
+        setDocs(rows);
+        setError(null);
+      })
+      .catch((e) => {
+        if (!cancelled) setError(String(e.message ?? e));
+      })
+      .finally(() => {
+        if (!cancelled) setLoading(false);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [query]);
+
+  if (loading) return <p role="status">Loading documents…</p>;
+  if (error) return <p role="alert">{error}</p>;
+
+  return (
+    <ul className="document-list">
+      {docs.map((d) => (
+        <li key={d.id}>
+          <a href={`/documents/${d.id}`}>{d.title}</a>
+          <time dateTime={d.updatedAt}>{new Date(d.updatedAt).toLocaleDateString()}</time>
+        </li>
+      ))}
+    </ul>
+  );
+}
