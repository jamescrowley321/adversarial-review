+"use strict";
+
+const express = require("express");
+const router = express.Router();
+const db = require("../db");
+
+// POST /api/v1/exports — queue a CSV export of the caller's records.
+router.post("/api/v1/exports", async (req, res) => {
+  const job = await db.exports.enqueue({
+    tenant_id: req.user.tenant_id,
+    requested_by: req.user.id,
+    format: "csv",
+  });
+  res.status(202).json({ id: job.id, status: job.status });
+});
+
+// GET /api/v1/exports/:id — poll a queued export.
+router.get("/api/v1/exports/:id", async (req, res) => {
+  const job = await db.exports.findById(req.params.id);
+  if (!job || job.tenant_id !== req.user.tenant_id) {
+    return res.status(404).json({ error: "not_found" });
+  }
+  res.json({ id: job.id, status: job.status, url: job.url || null });
+});
+
+module.exports = router;
