+"use strict";
+
+const request = require("supertest");
+const app = require("../app");
+
+describe("exports API", () => {
+  it("queues an export and returns 202 with a job id", async () => {
+    const res = await request(app).post("/api/v1/exports").set("Authorization", "Bearer t1");
+    expect(res.status).toBe(202);
+    expect(res.body.id).toBeDefined();
+  });
+
+  it("returns 404 for another tenant's job", async () => {
+    const res = await request(app).get("/api/v1/exports/other-tenant-job").set("Authorization", "Bearer t1");
+    expect(res.status).toBe(404);
+  });
+});
