+"use strict";
+
+// Round a currency amount to whole cents, avoiding float drift.
+function roundCents(amount) {
+  return Math.round((amount + Number.EPSILON) * 100) / 100;
+}
+
+// Sum a list of line-item amounts.
+function subtotal(lineItems) {
+  return roundCents(lineItems.reduce((acc, li) => acc + li.amount, 0));
+}
+
+module.exports = { roundCents, subtotal };
