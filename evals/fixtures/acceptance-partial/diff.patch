+"use strict";
+
+const express = require("express");
+const { getWidget } = require("../store");
+
+const router = express.Router();
+
+router.get("/api/v1/widgets/:id", async (req, res) => {
+  const widget = await getWidget(req.params.id);
+  if (!widget) {
+    return res.status(404).json({ error: "not_found" });
+  }
+  return res.json({ id: widget.id, name: widget.name, createdAt: widget.createdAt });
+});
+
+module.exports = router;
